<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.platymuus</groupId>
    <artifactId>bukkit-permissions</artifactId>
    <version>2.5-SuCraft</version><!-- SuCraft - Mark SuCraft version -->
    <name>PermissionsBukkit</name>
    <url>http://dev.bukkit.org/server-mods/permbukkit/</url>

    <!-- SuCraft start - Update dependencies -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.3.build,)</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <!-- SuCraft end - Update dependencies -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version><!-- SuCraft - Update dependencies -->
                <configuration>
                    <!-- SuCraft start - Update dependencies -->
                    <source>25</source>
                    <target>25</target>
                    <!-- SuCraft end - Update dependencies -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version><!-- SuCraft - Update dependencies -->
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.mcstats.bukkit</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
